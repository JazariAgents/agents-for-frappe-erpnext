{
  "description": "Jazari Agents for Frappe & ERPNext: in a folder connected to a Frappe site, route requests through the plugin's rules, block changes made through Frappe's MCP tools unless the record was snapshotted first, and hold a change until the user has replied after the snapshot was saved.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_context.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_context.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create_document|update_document|delete_document|call_document_method|call_method)",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_guard.py\" 2>/dev/null || sh \"${CLAUDE_PLUGIN_ROOT}/hooks/no_python.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_context.py\" --answered 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/frappe_context.py\" --answered 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
